<h3 class="mb-4">
    {{ store.name }} · {{ 'ui.schedule'|trans }}
</h3>
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Día</th>
            <th>Horario</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    {% for schedule in pagination %}
        <tr>
            <td>{{ schedule.weekDay|capitalize }}</td>
            <td>
                {% if schedule.open %}
                    {{ schedule.timeFrom }} – {{ schedule.timeTo }}
                {% else %}
                    —
                {% endif %}
            </td>
            <td>
                <span class="badge {{ schedule.open ? 'text-bg-success' : 'text-bg-secondary' }}">
                    {{ schedule.open ? 'Abierto' : 'Cerrado' }}
                </span>
            </td>
            <td>
                <a href="{{ path('backend_store_schedule_edit', {
                    store: store.id,
                    id: schedule.id
                }) }}" class="btn btn-sm btn-light">
                    {{ 'ui.edit'|trans }}
                </a>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="4">{{ 'ui.no_records_found'|trans }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
