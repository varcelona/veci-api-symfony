<table class="table align-middle">
    <thead>
        <tr>
            <th>{{ 'ui.day'|trans }}</th>
            <th>{{ 'ui.from'|trans }}</th>
            <th>{{ 'ui.to'|trans }}</th>
            <th class="text-center">{{ 'ui.open'|trans }}</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
    {% for s in schedules %}
        {% include '@backend/store_schedule/_row.html.twig' with { s: s } %}
    {% else %}
        <tr>
            <td colspan="5" class="text-center text-muted">
                {{ 'ui.no_records_found'|trans }}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<button type="button"
        class="btn btn-sm btn-outline-primary mt-3"
        data-action="click->store-schedule#addRow">
    + {{ 'ui.modal.store_schedule.add_schedule'|trans }}
</button>
