{{ form_start(form, {'attr': {'class': 'my-auto me-5 row gx-0 needs-validation was-validated'}}) }}
<div class="col-9 mb-3 mb-xl-10">

    <div class="card mb-5 mb-xl-10">
        <div class="card-title py-4 px-5 m-0">
            <h3 class="fw-bold m-0">
                <i class="bi bi-{{ config.icon }}"></i> {{ block_header }}
            </h3>
        </div>

        <div class="card-body p-5 m-0 pt-2">
            <div class="row">
                <div class="col mb-4">
                    {{ form_row(form.name) }}
                </div>

                <div class="col mb-4">
                    {{ form_row(form.slug) }}
                </div>
            </div>

            <div class="row">
                <div class="col mb-4">
                    {{ form_row(form.address) }}
                </div>
            </div>

            <div class="row">
                <div class="col mb-4">
                    {{ form_row(form.description) }}
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-5 mb-xl-10">
        <div class="card-title py-4 px-5 m-0">
            <h3 class="fw-bold m-0">{{ 'ui.contact'|trans }}</h3>
        </div>

        <div class="card-body p-5 m-0 pt-2">
            <div class="row">
                <div class="col mb-4">
                    {{ form_row(form.email) }}
                </div>

                <div class="col mb-4">
                    {{ form_row(form.phone) }}
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-5 mb-xl-10">
        <div class="card-title py-4 px-5 m-0">
            <h3 class="fw-bold m-0">{{ 'ui.settings'|trans }}</h3>
        </div>

        <div class="card-body p-5 m-0 pt-2">
            <div class="row">
                <div class="col mb-4">
                    {{ form_row(form.brand) }}
                </div>
            </div>

            <div>
                {{ form_widget(form.enabled) }}
            </div>
        </div>
    </div>

</div>

<div class="col-3 ps-5">
    <div class="sticky-top">
        {{ include('@backend/store/_store_aside.html.twig', {'store': entity}) }}
    </div>
</div>

{{ form_end(form) }}

<!-- incluye el form de horarios -->
{% include '@backend/store_schedule/_modal.html.twig' with { store: entity } %}
