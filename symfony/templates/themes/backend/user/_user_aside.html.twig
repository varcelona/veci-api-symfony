<div class="card mb-5 mb-xl-10">
    <div class="card-title py-4 px-5 m-0">
        <h3 class="fw-bold m-0">{{ 'ui.avatar'|trans }}</h3>
    </div>

    <div class="card-body p-5 m-0 pt-2">
        <div class="d-flex flex-column justify-content-center text-center">
            <div class="symbol symbol-100px symbol-circle mb-3">
                <div class="col mb-4">
                <!-- {% if user.profile is not null %}
                    {{ form_row(form.profile.image, { 'attr': { 'image': user.profile.image }}) }}
                {% else %} -->
                    {{ form_widget(form.profile.image) }}
                <!-- {% endif %} -->
                </div>
            </div>

            {% if isNew is not defined %}
            <div class="fs-4 fw-bold mb-2">
                {{ user.fullName }}
            </div>

            <div class="mb-5">
                <div class="mb-1">
                    <span class="badge text-bg-primary text-white">{{ user.roles|first|trans }}</span>
                </div>
            </div>
            {% endif %}
        </div>

        {% if isNew is not defined %}
        <div class="d-flex flex-column">
            <div class="fw-bold fs-4 border-bottom">
                {{ 'ui.details'|trans }}
            </div>

            <div class="fs-6 mb-2 mt-3">
                <div class="fw-bold">{{ 'ui.account_id'|trans }}</div>
                <div class="text-gray-600">ID-{{ user.id }}</div>
            </div>

            <div class="fs-6 mb-2 mt-3">
                <div class="fw-bold">{{ 'ui.email'|trans }}</div>
                <div class="text-gray-600">
                    {{ user.email }}
                </div>
            </div>

            <div class="fs-6 mb-2 mt-3">
                <div class="fw-bold">{{ 'ui.user_status'|trans }}</div>
                <div class="text-gray-600">
                    {% set userEnabledIcon = user.enabled ? 'bi-check2-circle' : 'bi-ban' %}
                    {% set userEnabledColor = user.enabled ? 'success' : 'warning' %}
                    <span>{{ 'ui.user_enabled'|trans }}</span>
                    <i class="bi {{ userEnabledIcon }} fs-5 {{ userEnabledColor }} ms-2"></i>
                </div>
                <div class="text-gray-600">
                    {% set userVerifiedIcon = user.verified ? 'bi-check2-circle' : 'bi-ban' %}
                    {% set userVerifiedColor = user.verified ? 'success' : 'warning' %}
                    <span>{{ 'ui.user_verified'|trans }}</span>
                    <i class="bi {{ userVerifiedIcon }} fs-5 {{ userVerifiedColor }} ms-2"></i>
                    {% if not user.verified %}
                        <a class="btn btn-sm mt-3 btn-success" href="{{ path('backend_user_verify', {'id': entity.id}) }}">{{ 'ui.button.send_verification'|trans }}</a>
                    {% endif %}
                </div>
            </div>

            <div class="fs-6 mb-2 mt-3">
                <div class="fw-bold">{{ 'ui.last_login'|trans }}</div>
                <div class="text-gray-600">{{ user.updatedAt ? user.updatedAt|date('d M Y, H:i') : '' }}</div>
            </div>

            {% if user.enabled %}
            <div class="dropdown">
                <button type="button" class="btn mt-3 btn-danger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                {{ 'ui.button.block_account'|trans }}
                </button>

                <ul class="dropdown-menu">
                    <li><a class="dropdown-item text-uppercase" href="{{ path('backend_user_suspend', {'id': entity.id, '_token': csrf_token('suspend' ~ user.id)}) }}">{{ 'ui.button.block_account_confirm'|trans }}</a></li>
                </ul>
            </div>
            {% endif %}
        </div>
        {% endif %}
    </div>

    <div class="card-footer d-flex justify-content-end p-5 pb-4">
        <a href="{{ app.request.headers.get('referer') }}" class="btn btn-light me-2">{{ 'ui.button.cancel'|trans }}</a>
        <button type="submit" class="btn btn-primary">{{ button_label|default('ui.button.save')|trans }}</button>
    </div>
</div>