{% extends '@backend/authentication/emails/base.html.twig' %}

{% block body %}
  <div style="padding-bottom: 30px; font-size: 17px;">
      <strong>{{ settings.prop.siteUrl ~ ' (' ~ settings.prop.siteName ~')' }}</strong>
  </div>

  <div style="padding-bottom: 30px">
      {{ user }}:
      <br>
      {{ 'ui.emails.reset_password_message_open'|trans }}
  </div>

  <div style="padding-bottom: 40px; text-align:center;">
      <a href="{{ resetUrl }}">{{ resetUrl }}</a>
  </div>

  <div style="padding-bottom: 30px">
    <small>{{ 'ui.emails.reset_password_message_close'|trans }} {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</small>
  </div>
{% endblock %}