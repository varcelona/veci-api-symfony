{% extends '@backend/authentication/emails/base.html.twig' %}

{% block body %}
  <div style="padding-bottom: 30px; font-size: 17px;">
      <strong>{{ settings.prop.siteUrl ~ ' (' ~ settings.prop.siteName ~')' }}</strong>
  </div>

  <div style="padding-bottom: 30px">
      {{ user }}:
      <br>
      {{ 'ui.emails.auth_code_message_open'|trans }}
  </div>

  <div style="padding-bottom: 40px; text-align:center;">
      <div style="text-decoration:none;display:inline-block;text-align:center;padding:0.75575rem 1.3rem;font-size:1.925rem;line-height:1.5;border-radius:0.35rem;color:#ffffff;background-color:#009ef7;border:0px;margin-right:0.75rem!important;font-weight:600!important;outline:none!important;vertical-align:middle">
          {{ authCode }}
      </div>
  </div>

  <div style="padding-bottom: 30px">
    <small>{{ 'ui.emails.auth_code_message_close'|trans }}</small>
  </div>
{% endblock %}